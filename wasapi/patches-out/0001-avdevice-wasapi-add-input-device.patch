+    int      list_devices;
+    int      loopback;          /* -1 auto, 0 off, 1 on */
+    int      exclusive;
+    int      buffer_ms;
+    int      pid;
+    int      exclude_pid;
+    int      fill_silence;
+    int      silence_ms;
+    int      req_sample_rate;
+    int      req_channels;
+    int      req_sample_fmt;    /* 0 = auto/float, 1 = s16 */
+
+    /* COM state */
+    int                   com_initialized;
+    IMMDeviceEnumerator  *enumerator;
+    IMMDevice            *device;
+    IAudioClient         *client;
+    IAudioCaptureClient  *capture;
+    HANDLE                event;
+    HMODULE               mmdevapi;
+
+    /* stream state */
+    int      sample_rate;
+    int      channels;
+    int      frame_size;        /* bytes per frame (all channels) */
+    int64_t  next_pts;          /* in samples */
+    int64_t  start_time;        /* av_gettime_relative() at start */
+    int      started;
+    int      eof;
+} WasapiContext;
