 doc/indevs.texi          |   85 +++
 libavdevice/Makefile     |    1 +
 libavdevice/alldevices.c |    1 +
 libavdevice/wasapi_dec.c | 1111 ++++++++++++++++++++++++++++++++++++++
 5 files changed, 1201 insertions(+)
 create mode 100755 libavdevice/wasapi_dec.c

