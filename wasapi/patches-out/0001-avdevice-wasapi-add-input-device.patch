+static char *wchar_to_utf8(const wchar_t *w)
+{
+    char *out;
+    int len;
+
+    if (!w)
+        return NULL;
+
+    len = WideCharToMultiByte(CP_UTF8, 0, w, -1, NULL, 0, NULL, NULL);
+    if (len <= 0)
+        return NULL;
+
+    out = av_mallocz(len);
+    if (!out)
+        return NULL;
+
+    if (WideCharToMultiByte(CP_UTF8, 0, w, -1, out, len, NULL, NULL) <= 0) {
+        av_free(out);
+        return NULL;
+    }
+
+    return out;
+}
+
+av_unused static wchar_t *utf8_to_wchar(const char *s)
+{
+    wchar_t *out;
+    int len;
+
+    if (!s)
+        return NULL;
+
+    len = MultiByteToWideChar(CP_UTF8, 0, s, -1, NULL, 0);
+    if (len <= 0)
+        return NULL;
+
+    out = av_mallocz(len * sizeof(wchar_t));
+    if (!out)
+        return NULL;
+
+    if (MultiByteToWideChar(CP_UTF8, 0, s, -1, out, len) <= 0) {
+        av_free(out);
+        return NULL;
+    }
+
+    return out;
+}
+
+/* Retrieve the human readable name of an endpoint. Caller frees. */
+static char *device_friendly_name(IMMDevice *dev)
+{
+    IPropertyStore *props = NULL;
+    PROPVARIANT var;
+    char *name = NULL;
+
+    if (FAILED(IMMDevice_OpenPropertyStore(dev, STGM_READ, &props)))
+        return NULL;
+
+    PropVariantInit(&var);
+    if (SUCCEEDED(IPropertyStore_GetValue(props, &ff_PKEY_Device_FriendlyName, &var)) &&
+        var.vt == VT_LPWSTR)
+        name = wchar_to_utf8(var.pwszVal);
+
+    PropVariantClear(&var);
+    IPropertyStore_Release(props);
+
+    return name;
+}
+
+static char *device_id_utf8(IMMDevice *dev)
+{
+    LPWSTR wid = NULL;
+    char *id;
+
+    if (FAILED(IMMDevice_GetId(dev, &wid)))
+        return NULL;
+
+    id = wchar_to_utf8(wid);
+    CoTaskMemFree(wid);
+
+    return id;
+}
+
+/* ------------------------------------------------------------------------ */
+/* device listing / lookup                                                   */
+/* ------------------------------------------------------------------------ */
+
+static void list_endpoints(AVFormatContext *avctx, EDataFlow flow, const char *title)
+{
+    WasapiContext *s = avctx->priv_data;
+    IMMDeviceCollection *coll = NULL;
+    IMMDevice *defdev = NULL;
+    char *defid = NULL;
+    UINT count = 0, i;
+
+    if (FAILED(IMMDeviceEnumerator_EnumAudioEndpoints(s->enumerator, flow,
+                                                      DEVICE_STATE_ACTIVE, &coll)))
+        return;
+
+    if (SUCCEEDED(IMMDeviceEnumerator_GetDefaultAudioEndpoint(s->enumerator, flow,
+                                                              eConsole, &defdev))) {
+        defid = device_id_utf8(defdev);
+        IMMDevice_Release(defdev);
+    }
+
+    IMMDeviceCollection_GetCount(coll, &count);
+    av_log(avctx, AV_LOG_INFO, "%s\n", title);
+
+    for (i = 0; i < count; i++) {
+        IMMDevice *dev = NULL;
+        char *name, *id;
+
+        if (FAILED(IMMDeviceCollection_Item(coll, i, &dev)))
+            continue;
+
+        name = device_friendly_name(dev);
+        id   = device_id_utf8(dev);
+
+        av_log(avctx, AV_LOG_INFO, "  \"%s\"%s\n",
+               name ? name : "unknown",
+               (defid && id && !strcmp(defid, id)) ? "  (default)" : "");
+        av_log(avctx, AV_LOG_INFO, "     id: \"%s\"\n", id ? id : "unknown");
+
+        av_free(name);
+        av_free(id);
+        IMMDevice_Release(dev);
+    }
+
+    av_free(defid);
+    IMMDeviceCollection_Release(coll);
+}
+
+static int do_list_devices(AVFormatContext *avctx)
+{
+    list_endpoints(avctx, eRender,
+                   "WASAPI render (playback) devices -- capture these with loopback:");
+    list_endpoints(avctx, eCapture,
+                   "WASAPI capture (recording) devices:");
+    av_log(avctx, AV_LOG_INFO,
+           "Use \"default\" / \"default_output\" for the default playback device (loopback),\n"
+           "    \"default_input\" for the default recording device,\n"
+           "    \"pid=<number>\" to capture a single process (Windows 11 / Server 2022+).\n");
+    return AVERROR_EXIT;
+}
+
+/* Find an endpoint by friendly name or by endpoint id. */
+static int find_device(AVFormatContext *avctx, const char *wanted,
+                       EDataFlow flow, IMMDevice **out)
+{
+    WasapiContext *s = avctx->priv_data;
+    IMMDeviceCollection *coll = NULL;
+    IMMDevice *fallback = NULL;
+    UINT count = 0, i;
+    int ret = AVERROR(ENODEV);
+
+    if (FAILED(IMMDeviceEnumerator_EnumAudioEndpoints(s->enumerator, flow,
+                                                      DEVICE_STATE_ACTIVE, &coll)))
+        return AVERROR_EXTERNAL;
+
+    IMMDeviceCollection_GetCount(coll, &count);
+
+    for (i = 0; i < count; i++) {
+        IMMDevice *dev = NULL;
+        char *name, *id;
+        int exact = 0, partial = 0;
+
+        if (FAILED(IMMDeviceCollection_Item(coll, i, &dev)))
+            continue;
+
+        name = device_friendly_name(dev);
+        id   = device_id_utf8(dev);
+
+        if ((id   && !strcmp(id, wanted)) ||
+            (name && !strcmp(name, wanted)))
+            exact = 1;
+        else if (name && av_stristr(name, wanted))
+            partial = 1;
+
+        av_free(name);
+        av_free(id);
+
+        if (exact) {
+            if (fallback)
+                IMMDevice_Release(fallback);
+            *out = dev;
+            ret = 0;
+            break;
+        }
+
+        if (partial && !fallback) {
+            fallback = dev;
+            continue;
+        }
+
+        IMMDevice_Release(dev);
+    }
+
+    if (ret < 0 && fallback) {
+        *out = fallback;
+        ret = 0;
+    } else if (ret == 0 && fallback && *out != fallback) {
+        IMMDevice_Release(fallback);
+    }
+
+    IMMDeviceCollection_Release(coll);
+
+    return ret;
+}
+
+/* ------------------------------------------------------------------------ */
+/* process loopback activation                                               */
+/* ------------------------------------------------------------------------ */
+
+static HRESULT STDMETHODCALLTYPE handler_QueryInterface(
+    FFIActivateAudioInterfaceCompletionHandler *self, REFIID riid, void **obj)
+{
+    if (!obj)
+        return E_POINTER;
+
+    if (IsEqualGUID(riid, &IID_IUnknown) ||
+        IsEqualGUID(riid, &ff_IID_IActivateAudioInterfaceCompletionHandler) ||
+        IsEqualGUID(riid, &ff_IID_IAgileObject)) {
+        *obj = self;
+        InterlockedIncrement(&self->refcount);
+        return S_OK;
+    }
+
+    *obj = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG STDMETHODCALLTYPE handler_AddRef(FFIActivateAudioInterfaceCompletionHandler *self)
+{
+    return InterlockedIncrement(&self->refcount);
+}
+
+static ULONG STDMETHODCALLTYPE handler_Release(FFIActivateAudioInterfaceCompletionHandler *self)
+{
+    return InterlockedDecrement(&self->refcount);
+}
+
+static HRESULT STDMETHODCALLTYPE handler_ActivateCompleted(
+    FFIActivateAudioInterfaceCompletionHandler *self,
+    FFIActivateAudioInterfaceAsyncOperation *op)
+{
+    SetEvent(self->event);
+    return S_OK;
+}
+
+static const FFIActivateAudioInterfaceCompletionHandlerVtbl handler_vtbl = {
+    handler_QueryInterface,
+    handler_AddRef,
+    handler_Release,
+    handler_ActivateCompleted,
+};
+
+static int activate_process_loopback(AVFormatContext *avctx, IAudioClient **out)
+{
+    WasapiContext *s = avctx->priv_data;
+    ff_ActivateAudioInterfaceAsync_t activate_async;
+    FFIActivateAudioInterfaceCompletionHandler *handler = NULL;
+    FFIActivateAudioInterfaceAsyncOperation *op = NULL;
+    FF_AUDIOCLIENT_ACTIVATION_PARAMS params = { 0 };
+    PROPVARIANT prop;
+    HRESULT hr, activate_hr = E_FAIL;
+    IUnknown *unk = NULL;
+    int ret = 0;
+
+    s->mmdevapi = LoadLibraryW(L"mmdevapi.dll");
+    if (!s->mmdevapi) {
+        av_log(avctx, AV_LOG_ERROR, "Could not load mmdevapi.dll\n");
+        return AVERROR_EXTERNAL;
+    }
+
+    activate_async = (ff_ActivateAudioInterfaceAsync_t)
+        (void *)GetProcAddress(s->mmdevapi, "ActivateAudioInterfaceAsync");
+    if (!activate_async) {
+        av_log(avctx, AV_LOG_ERROR,
+               "Per-process capture requires Windows 10 build 20348 or newer "
+               "(ActivateAudioInterfaceAsync is unavailable on this system).\n");
+        return AVERROR(ENOSYS);
+    }
+
+    /* Heap allocated on purpose: if the activation ever times out, COM may still
+     * invoke the callback later, and a stack object would be long gone by then. */
+    handler = av_mallocz(sizeof(*handler));
+    if (!handler)
+        return AVERROR(ENOMEM);
+
+    handler->lpVtbl   = &handler_vtbl;
+    handler->refcount = 1;
+    handler->event    = CreateEventW(NULL, FALSE, FALSE, NULL);
+    if (!handler->event) {
+        av_free(handler);
+        return AVERROR(ENOMEM);
+    }
+
+    params.ActivationType = FF_AUDIOCLIENT_ACTIVATION_TYPE_PROCESS_LOOPBACK;
+    params.ProcessLoopbackParams.TargetProcessId     = (DWORD)s->pid;
+    params.ProcessLoopbackParams.ProcessLoopbackMode = s->exclude_pid ?
+        FF_PROCESS_LOOPBACK_MODE_EXCLUDE_TARGET_PROCESS_TREE :
+        FF_PROCESS_LOOPBACK_MODE_INCLUDE_TARGET_PROCESS_TREE;
+
+    PropVariantInit(&prop);
+    prop.vt              = VT_BLOB;
+    prop.blob.cbSize     = sizeof(params);
+    prop.blob.pBlobData  = (BYTE *)&params;
+
+    hr = activate_async(FF_VIRTUAL_AUDIO_DEVICE_PROCESS_LOOPBACK,
+                        &IID_IAudioClient, &prop, handler, &op);
+    if (FAILED(hr)) {
+        av_log(avctx, AV_LOG_ERROR,
+               "ActivateAudioInterfaceAsync failed: %s (0x%08lX)\n",
+               hr2str(hr), (unsigned long)hr);
+        ret = AVERROR_EXTERNAL;
+        goto end;
+    }
+
+    if (WaitForSingleObject(handler->event, 5000) != WAIT_OBJECT_0) {
+        av_log(avctx, AV_LOG_ERROR, "Timed out activating process loopback capture\n");
+        ret = AVERROR(ETIMEDOUT);
+        goto end;
+    }
+
+    hr = op->lpVtbl->GetActivateResult(op, &activate_hr, &unk);
+    if (FAILED(hr) || FAILED(activate_hr)) {
+        HRESULT bad = FAILED(hr) ? hr : activate_hr;
+        av_log(avctx, AV_LOG_ERROR,
+               "Process loopback activation failed: %s (0x%08lX). "
+               "Does pid %d exist and is it playing audio?\n",
+               hr2str(bad), (unsigned long)bad, s->pid);
+        ret = AVERROR_EXTERNAL;
+        goto end;
+    }
+
+    hr = IUnknown_QueryInterface(unk, &IID_IAudioClient, (void **)out);
+    if (FAILED(hr)) {
+        av_log(avctx, AV_LOG_ERROR, "Could not obtain IAudioClient: %s\n", hr2str(hr));
+        ret = AVERROR_EXTERNAL;
+    }
+
+end:
+    if (unk)
+        IUnknown_Release(unk);
+    if (op)
+        op->lpVtbl->Release(op);
+    if (handler && InterlockedDecrement(&handler->refcount) <= 0) {
+        CloseHandle(handler->event);
+        av_free(handler);
+    }   /* else COM still holds a reference; leaking beats a dangling callback */
+
+    return ret;
+}
+
+/* ------------------------------------------------------------------------ */
+/* format handling                                                           */
+/* ------------------------------------------------------------------------ */
+
+static int waveformat_to_codec(AVFormatContext *avctx, const WAVEFORMATEX *wf,
+                               enum AVCodecID *codec_id, uint64_t *mask)
+{
+    const WAVEFORMATEXTENSIBLE *wfe = NULL;
+    WORD tag = wf->wFormatTag;
+
+    *mask = 0;
+
+    if (tag == WAVE_FORMAT_EXTENSIBLE && wf->cbSize >= 22) {
+        wfe   = (const WAVEFORMATEXTENSIBLE *)wf;
+        *mask = wfe->dwChannelMask;
+
+        if (IsEqualGUID(&wfe->SubFormat, &ff_KSDATAFORMAT_SUBTYPE_IEEE_FLOAT))
+            tag = WAVE_FORMAT_IEEE_FLOAT;
+        else if (IsEqualGUID(&wfe->SubFormat, &ff_KSDATAFORMAT_SUBTYPE_PCM))
+            tag = WAVE_FORMAT_PCM;
+        else {
+            av_log(avctx, AV_LOG_ERROR, "Unsupported WASAPI subformat\n");
+            return AVERROR(ENOSYS);
+        }
+    }
+
+    if (tag == WAVE_FORMAT_IEEE_FLOAT) {
+        if (wf->wBitsPerSample == 32)
+            *codec_id = AV_CODEC_ID_PCM_F32LE;
+        else if (wf->wBitsPerSample == 64)
+            *codec_id = AV_CODEC_ID_PCM_F64LE;
+        else
+            goto unsupported;
+    } else if (tag == WAVE_FORMAT_PCM) {
+        switch (wf->wBitsPerSample) {
+        case 8:  *codec_id = AV_CODEC_ID_PCM_U8;    break;
+        case 16: *codec_id = AV_CODEC_ID_PCM_S16LE; break;
+        case 24: *codec_id = AV_CODEC_ID_PCM_S24LE; break;
+        case 32: *codec_id = AV_CODEC_ID_PCM_S32LE; break;
+        default: goto unsupported;
+        }
+    } else {
+        goto unsupported;
+    }
+
+    return 0;
+
+unsupported:
+    av_log(avctx, AV_LOG_ERROR,
+           "Unsupported WASAPI format: tag %d, %d bits\n", tag, wf->wBitsPerSample);
+    return AVERROR(ENOSYS);
+}
+
+static void fill_waveformat(WAVEFORMATEXTENSIBLE *wfe, int rate, int channels, int use_float)
+{
+    WAVEFORMATEX *wf = &wfe->Format;
+    int bits = use_float ? 32 : 16;
+
+    memset(wfe, 0, sizeof(*wfe));
+
+    wf->wFormatTag      = WAVE_FORMAT_EXTENSIBLE;
+    wf->nChannels       = channels;
+    wf->nSamplesPerSec  = rate;
+    wf->wBitsPerSample  = bits;
+    wf->nBlockAlign     = channels * bits / 8;
+    wf->nAvgBytesPerSec = rate * wf->nBlockAlign;
+    wf->cbSize          = sizeof(WAVEFORMATEXTENSIBLE) - sizeof(WAVEFORMATEX);
+
+    wfe->Samples.wValidBitsPerSample = bits;
+    wfe->dwChannelMask = channels == 1 ? SPEAKER_FRONT_CENTER
+                                       : (SPEAKER_FRONT_LEFT | SPEAKER_FRONT_RIGHT);
+    wfe->SubFormat = use_float ? ff_KSDATAFORMAT_SUBTYPE_IEEE_FLOAT
+                               : ff_KSDATAFORMAT_SUBTYPE_PCM;
+}
+
+/* ------------------------------------------------------------------------ */
+/* demuxer                                                                   */
+/* ------------------------------------------------------------------------ */
+
+static int wasapi_read_close(AVFormatContext *avctx);
+
+static int wasapi_read_header(AVFormatContext *avctx)
+{
+    WasapiContext *s = avctx->priv_data;
+    WAVEFORMATEX *mix = NULL;
+    WAVEFORMATEXTENSIBLE forced;
+    const WAVEFORMATEX *wf = NULL;
+    AVStream *st;
+    enum AVCodecID codec_id;
+    uint64_t mask = 0;
+    DWORD flags = 0;
+    REFERENCE_TIME duration;
+    const char *name = avctx->url;
+    EDataFlow flow = eRender;
+    HRESULT hr;
+    int ret, is_loopback, process_mode = 0;
+
+    hr = CoInitializeEx(NULL, COINIT_MULTITHREADED);
+    if (hr == RPC_E_CHANGED_MODE) {
+        /* Somebody already initialised COM as STA in this thread; that is fine. */
+        s->com_initialized = 0;
+    } else if (FAILED(hr)) {
+        av_log(avctx, AV_LOG_ERROR, "CoInitializeEx failed: %s\n", hr2str(hr));
+        return AVERROR_EXTERNAL;
+    } else {
+        s->com_initialized = 1;
+    }
+
+    hr = CoCreateInstance(&CLSID_MMDeviceEnumerator, NULL, CLSCTX_ALL,
+                          &IID_IMMDeviceEnumerator, (void **)&s->enumerator);
+    if (FAILED(hr)) {
+        av_log(avctx, AV_LOG_ERROR, "Could not create device enumerator: %s\n", hr2str(hr));
+        ret = AVERROR_EXTERNAL;
+        goto fail;
+    }
+
+    if (s->list_devices) {
+        ret = do_list_devices(avctx);
+        goto fail;
+    }
+
+    /* "pid=1234" as input name is a shorthand for -pid 1234 */
+    if (name && !av_strncasecmp(name, "pid=", 4)) {
+        s->pid = atoi(name + 4);
+        name = "";
+    }
+
+    if (s->pid > 0)
+        process_mode = 1;
+
+    if (!process_mode) {
+        if (!name || !*name || !av_strcasecmp(name, "default") ||
+            !av_strcasecmp(name, "default_output")) {
+            flow = eRender;
+            hr = IMMDeviceEnumerator_GetDefaultAudioEndpoint(s->enumerator, eRender,
+                                                             eConsole, &s->device);
+        } else if (!av_strcasecmp(name, "default_input")) {
+            flow = eCapture;
+            hr = IMMDeviceEnumerator_GetDefaultAudioEndpoint(s->enumerator, eCapture,
+                                                             eConsole, &s->device);
+        } else {
+            /* Look at render endpoints first, then capture endpoints. */
+            flow = eRender;
+            ret  = find_device(avctx, name, eRender, &s->device);
+            if (ret < 0) {
+                flow = eCapture;
+                ret  = find_device(avctx, name, eCapture, &s->device);
+            }
+            if (ret < 0) {
+                av_log(avctx, AV_LOG_ERROR,
+                       "Could not find audio device \"%s\". "
+                       "Run with -list_devices true to see the available devices.\n", name);
+                goto fail;
+            }
+            hr = S_OK;
+        }
+
+        if (FAILED(hr) || !s->device) {
+            av_log(avctx, AV_LOG_ERROR, "Could not open audio device: %s\n", hr2str(hr));
+            ret = AVERROR(ENODEV);
+            goto fail;
+        }
+
+        {
+            char *fname = device_friendly_name(s->device);
+            av_log(avctx, AV_LOG_INFO, "Using %s device \"%s\"\n",
+                   flow == eRender ? "render" : "capture", fname ? fname : "unknown");
+            av_free(fname);
+        }
+
+        hr = IMMDevice_Activate(s->device, &IID_IAudioClient, CLSCTX_ALL, NULL,
+                                (void **)&s->client);
+        if (FAILED(hr)) {
+            av_log(avctx, AV_LOG_ERROR, "Could not activate audio client: %s\n", hr2str(hr));
+            ret = AVERROR_EXTERNAL;
+            goto fail;
+        }
+    } else {
+        av_log(avctx, AV_LOG_INFO, "Capturing audio of process %d (%s process tree)\n",
+               s->pid, s->exclude_pid ? "excluding" : "including");
+        ret = activate_process_loopback(avctx, &s->client);
+        if (ret < 0)
+            goto fail;
+        flow = eRender;
+    }
+
+    /* loopback: automatic for render endpoints, always on for process capture */
+    is_loopback = process_mode ? 1 :
+                  (s->loopback >= 0 ? s->loopback : (flow == eRender));
+
+    if (is_loopback && s->exclusive) {
+        av_log(avctx, AV_LOG_ERROR,
+               "Loopback capture is not possible in exclusive mode.\n");
+        ret = AVERROR(EINVAL);
+        goto fail;
+    }
+
+    if (process_mode) {
+        /* Process loopback cannot negotiate a mix format, it must be told one. */
+        fill_waveformat(&forced,
+                        s->req_sample_rate > 0 ? s->req_sample_rate : 48000,
+                        s->req_channels    > 0 ? s->req_channels    : 2,
+                        s->req_sample_fmt == 1 ? 0 : 1);
+        wf = &forced.Format;
+    } else if (s->req_sample_rate > 0 || s->req_channels > 0 || s->req_sample_fmt == 1) {
+        hr = IAudioClient_GetMixFormat(s->client, &mix);
+        if (FAILED(hr)) {
+            av_log(avctx, AV_LOG_ERROR, "GetMixFormat failed: %s\n", hr2str(hr));
+            ret = AVERROR_EXTERNAL;
+            goto fail;
+        }
+        fill_waveformat(&forced,
+                        s->req_sample_rate > 0 ? s->req_sample_rate : (int)mix->nSamplesPerSec,
+                        s->req_channels    > 0 ? s->req_channels    : mix->nChannels,
+                        s->req_sample_fmt == 1 ? 0 : 1);
+        wf = &forced.Format;
+    } else {
+        hr = IAudioClient_GetMixFormat(s->client, &mix);
+        if (FAILED(hr)) {
+            av_log(avctx, AV_LOG_ERROR, "GetMixFormat failed: %s\n", hr2str(hr));
+            ret = AVERROR_EXTERNAL;
+            goto fail;
+        }
+        wf = mix;
+    }
+
+    ret = waveformat_to_codec(avctx, wf, &codec_id, &mask);
+    if (ret < 0)
+        goto fail;
+
+    flags = 0;
+    if (is_loopback)
+        flags |= AUDCLNT_STREAMFLAGS_LOOPBACK;
+    if (process_mode || !is_loopback)
+        flags |= AUDCLNT_STREAMFLAGS_EVENTCALLBACK;
+
+    duration = (REFERENCE_TIME)s->buffer_ms * 10000;
+
+    hr = IAudioClient_Initialize(s->client,
+                                 s->exclusive ? AUDCLNT_SHAREMODE_EXCLUSIVE
+                                              : AUDCLNT_SHAREMODE_SHARED,
+                                 flags, duration,
+                                 s->exclusive ? duration : 0, wf, NULL);
+
+    if (hr == AUDCLNT_E_UNSUPPORTED_FORMAT && process_mode && s->req_sample_fmt != 1) {
+        av_log(avctx, AV_LOG_WARNING,
+               "Float capture rejected for process loopback, retrying with 16 bit PCM\n");
+        fill_waveformat(&forced,
+                        s->req_sample_rate > 0 ? s->req_sample_rate : 48000,
+                        s->req_channels    > 0 ? s->req_channels    : 2, 0);
+        wf  = &forced.Format;
+        ret = waveformat_to_codec(avctx, wf, &codec_id, &mask);
+        if (ret < 0)
+            goto fail;
+        hr = IAudioClient_Initialize(s->client, AUDCLNT_SHAREMODE_SHARED, flags,
+                                     duration, 0, wf, NULL);
+    }
+
+    if (FAILED(hr)) {
+        av_log(avctx, AV_LOG_ERROR, "IAudioClient::Initialize failed: %s (0x%08lX)\n",
+               hr2str(hr), (unsigned long)hr);
+        ret = AVERROR_EXTERNAL;
+        goto fail;
+    }
+
+    if (flags & AUDCLNT_STREAMFLAGS_EVENTCALLBACK) {
+        s->event = CreateEventW(NULL, FALSE, FALSE, NULL);
+        if (!s->event) {
+            ret = AVERROR(ENOMEM);
+            goto fail;
+        }
+        hr = IAudioClient_SetEventHandle(s->client, s->event);
+        if (FAILED(hr)) {
+            av_log(avctx, AV_LOG_ERROR, "SetEventHandle failed: %s\n", hr2str(hr));
+            ret = AVERROR_EXTERNAL;
+            goto fail;
+        }
+    }
+
+    hr = IAudioClient_GetService(s->client, &IID_IAudioCaptureClient, (void **)&s->capture);
+    if (FAILED(hr)) {
+        av_log(avctx, AV_LOG_ERROR, "Could not get capture service: %s\n", hr2str(hr));
+        ret = AVERROR_EXTERNAL;
+        goto fail;
+    }
+
+    s->sample_rate = wf->nSamplesPerSec;
+    s->channels    = wf->nChannels;
+    s->frame_size  = wf->nBlockAlign;
+
+    st = avformat_new_stream(avctx, NULL);
+    if (!st) {
+        ret = AVERROR(ENOMEM);
+        goto fail;
+    }
+
+    st->codecpar->codec_type            = AVMEDIA_TYPE_AUDIO;
+    st->codecpar->codec_id              = codec_id;
+    st->codecpar->sample_rate           = s->sample_rate;
+    st->codecpar->bits_per_coded_sample = wf->wBitsPerSample;
+    st->codecpar->block_align           = wf->nBlockAlign;
+    st->codecpar->bit_rate              = (int64_t)wf->nAvgBytesPerSec * 8;
+
+    if (mask)
+        av_channel_layout_from_mask(&st->codecpar->ch_layout, mask);
+    if (st->codecpar->ch_layout.nb_channels != s->channels) {
+        av_channel_layout_uninit(&st->codecpar->ch_layout);
+        av_channel_layout_default(&st->codecpar->ch_layout, s->channels);
+    }
+
+    avpriv_set_pts_info(st, 64, 1, s->sample_rate);
+
+    hr = IAudioClient_Start(s->client);
+    if (FAILED(hr)) {
+        av_log(avctx, AV_LOG_ERROR, "Could not start capture: %s\n", hr2str(hr));
+        ret = AVERROR_EXTERNAL;
+        goto fail;
+    }
+
+    s->started    = 1;
+    s->start_time = av_gettime_relative();
+    s->next_pts   = 0;
+
+    av_log(avctx, AV_LOG_INFO,
+           "Capturing %d Hz, %d channels, %s%s\n",
+           s->sample_rate, s->channels, avcodec_get_name(codec_id),
+           is_loopback ? ", loopback" : "");
+
+    if (mix)
+        CoTaskMemFree(mix);
+
+    return 0;
+
+fail:
+    if (mix)
+        CoTaskMemFree(mix);
+    /* keep the AVERROR_EXIT of -list_devices intact */
+    if (ret == 0)
+        ret = AVERROR_EXTERNAL;
+    wasapi_read_close(avctx);
+    return ret;
+}
+
+/* Produce a packet of digital silence covering the gap up to "now". */
+static int produce_silence(AVFormatContext *avctx, AVPacket *pkt, int64_t nb_samples)
+{
+    WasapiContext *s = avctx->priv_data;
+    int ret;
+
+    nb_samples = FFMIN(nb_samples, s->sample_rate / 10); /* at most 100 ms per packet */
+    if (nb_samples <= 0)
+        return AVERROR(EAGAIN);
+
+    ret = av_new_packet(pkt, nb_samples * s->frame_size);
+    if (ret < 0)
+        return ret;
+
+    memset(pkt->data, 0, pkt->size);
+    pkt->pts      = s->next_pts;
+    pkt->dts      = s->next_pts;
+    pkt->duration = nb_samples;
+    pkt->stream_index = 0;
+    s->next_pts  += nb_samples;
+
+    return 0;
+}
+
+static int wasapi_read_packet(AVFormatContext *avctx, AVPacket *pkt)
+{
+    WasapiContext *s = avctx->priv_data;
+    HRESULT hr;
+
+    for (;;) {
+        UINT32 nb_frames = 0;
+        BYTE *data = NULL;
+        DWORD bflags = 0;
+        int ret;
+
+        if (avctx->interrupt_callback.callback &&
+            avctx->interrupt_callback.callback(avctx->interrupt_callback.opaque))
+            return AVERROR_EXIT;
+
+        hr = IAudioCaptureClient_GetNextPacketSize(s->capture, &nb_frames);
+        if (hr == AUDCLNT_E_DEVICE_INVALIDATED) {
+            av_log(avctx, AV_LOG_ERROR, "Audio device was removed or reconfigured\n");
+            return AVERROR_EOF;
+        }
+        if (FAILED(hr)) {
+            av_log(avctx, AV_LOG_ERROR, "GetNextPacketSize failed: %s\n", hr2str(hr));
+            return AVERROR_EXTERNAL;
+        }
+
+        if (nb_frames) {
+            hr = IAudioCaptureClient_GetBuffer(s->capture, &data, &nb_frames, &bflags, NULL, NULL);
+            if (hr == AUDCLNT_S_BUFFER_EMPTY)
+                continue;
+            if (FAILED(hr)) {
+                av_log(avctx, AV_LOG_ERROR, "GetBuffer failed: %s\n", hr2str(hr));
+                return AVERROR_EXTERNAL;
+            }
+
+            if (bflags & AUDCLNT_BUFFERFLAGS_DATA_DISCONTINUITY)
+                av_log(avctx, AV_LOG_WARNING, "Audio capture glitch detected\n");
+
+            ret = av_new_packet(pkt, nb_frames * s->frame_size);
+            if (ret < 0) {
+                IAudioCaptureClient_ReleaseBuffer(s->capture, nb_frames);
+                return ret;
+            }
+
+            if (bflags & AUDCLNT_BUFFERFLAGS_SILENT)
+                memset(pkt->data, 0, pkt->size);
+            else
+                memcpy(pkt->data, data, pkt->size);
+
+            IAudioCaptureClient_ReleaseBuffer(s->capture, nb_frames);
+
+            pkt->pts          = s->next_pts;
+            pkt->dts          = s->next_pts;
+            pkt->duration     = nb_frames;
+            pkt->stream_index = 0;
+            s->next_pts      += nb_frames;
+
+            return 0;
+        }
+
+        /* No data available. A loopback stream produces nothing at all while the
+         * endpoint is idle, so synthesise silence to keep the timeline honest. */
+        if (s->fill_silence) {
+            int64_t now      = av_gettime_relative() - s->start_time;
+            int64_t expected = av_rescale(now, s->sample_rate, AV_TIME_BASE);
+            int64_t behind   = expected - s->next_pts;
+            int64_t trigger  = av_rescale(s->silence_ms, s->sample_rate, 1000);
+
+            if (behind > trigger)
+                return produce_silence(avctx, pkt, behind - trigger / 2);
+        }
+
+        if (s->event) {
+            if (WaitForSingleObject(s->event, 100) == WAIT_FAILED)
+                return AVERROR_EXTERNAL;
+        } else {
+            av_usleep(5000);
+        }
+    }
+}
+
+static int wasapi_read_close(AVFormatContext *avctx)
+{
+    WasapiContext *s = avctx->priv_data;
+
+    if (s->client && s->started)
+        IAudioClient_Stop(s->client);
+    s->started = 0;
+
+    if (s->capture) {
+        IAudioCaptureClient_Release(s->capture);
+        s->capture = NULL;
+    }
+    if (s->client) {
+        IAudioClient_Release(s->client);
+        s->client = NULL;
+    }
+    if (s->device) {
+        IMMDevice_Release(s->device);
+        s->device = NULL;
+    }
+    if (s->enumerator) {
+        IMMDeviceEnumerator_Release(s->enumerator);
+        s->enumerator = NULL;
+    }
+    if (s->event) {
+        CloseHandle(s->event);
+        s->event = NULL;
+    }
+    if (s->mmdevapi) {
+        FreeLibrary(s->mmdevapi);
+        s->mmdevapi = NULL;
+    }
+    if (s->com_initialized) {
+        CoUninitialize();
+        s->com_initialized = 0;
+    }
+
+    return 0;
+}
